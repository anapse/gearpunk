rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'height', 'createdAt']) &&
             data.keys().hasOnly(['playerName', 'score', 'height', 'createdAt']) &&
             data.playerName is string &&
             data.playerName.size() >= 1 &&
             data.playerName.size() <= 30 &&
             data.score is int &&
             data.score >= 0 &&
             data.height is int &&
             data.height >= 0 &&
             data.createdAt is timestamp;
    }

    function isValidVisitLog(data) {
      return data.keys().hasAll(['date', 'timestamp']) &&
             data.date is string &&
             data.timestamp is timestamp;
    }

    function isValidGameLog(data) {
      return data.keys().hasAll(['date', 'score', 'height', 'timestamp']) &&
             data.date is string &&
             data.score is int &&
             data.height is int &&
             data.timestamp is timestamp;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Leaderboard Collection
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow delete: if true; // Allowed for admin cleanup from dashboard
    }

    // Analytics Visits Collection
    match /analytics_visits/{visitId} {
      allow read: if true;
      allow create: if isValidId(visitId) && isValidVisitLog(request.resource.data);
    }

    // Analytics Games Collection
    match /analytics_games/{gameId} {
      allow read: if true;
      allow create: if isValidId(gameId) && isValidGameLog(request.resource.data);
    }
  }
}
