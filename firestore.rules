rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'height', 'createdAt']) &&
             data.keys().hasOnly(['playerName', 'score', 'height', 'createdAt']) &&
             data.playerName is string &&
             data.playerName.size() >= 1 &&
             data.playerName.size() <= 20 &&
             data.score is int &&
             data.score >= 0 &&
             data.height is int &&
             data.height >= 0 &&
             data.createdAt is timestamp;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Leaderboard Collection
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
